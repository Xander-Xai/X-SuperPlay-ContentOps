# Auto-detect text files and normalize line endings
* text=auto

# Scripts and code files
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf

# Config and data
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
# Data and vector sources are digested by `scripts/x_growth_pin.py`. Without an
# explicit eol both are checked out as CRLF on a Windows host with autocrlf=true
# and as LF on CI, so the pinned digest would disagree with itself across hosts.
*.csv text eol=lf
*.svg text eol=lf

# Binary media — never modify
*.mp4  binary
*.wav  binary
*.mp3  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.srt  binary
*.ass  binary
*.pdf  binary
*.zip  binary
*.tar  binary
*.gz   binary
*.exe  binary
*.dll  binary
*.so   binary
*.pyd  binary

# The vendored 公众号 tree is a byte-exact import. `-text -eol` stops Git from
# rewriting line endings, so a checkout here reproduces what was imported rather
# than what the platform's `core.autocrlf` prefers. The pin digest is deliberately
# line-ending-agnostic (see `scripts/gzh_pin.py`), so this rule protects fidelity;
# it is not what makes the pin platform-independent.
vendor/gzh-thinktank/** -text -eol
projects/gzh-thinktank/** -text -eol
