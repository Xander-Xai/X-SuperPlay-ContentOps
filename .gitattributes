# Auto-detect text files and normalize line endings
* text=auto

# Scripts and code files
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf

# Config and data
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Binary media — never modify
*.mp4  binary
*.wav  binary
*.mp3  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.srt  binary
*.ass  binary
*.pdf  binary
*.zip  binary
*.tar  binary
*.gz   binary
*.exe  binary
*.dll  binary
*.so   binary
*.pyd  binary
