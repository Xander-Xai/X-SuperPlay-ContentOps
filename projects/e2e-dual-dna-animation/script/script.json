  "lines": [
    {
      "id": "fi01",
      "claim": null,
      "narration": "做一条能发的技术片，靠的不是一个万能动画库，而是三类镜头各就各位。",
      "caption": "三类镜头，不是万能的库",
      "asset_id": "fi-pain"
    },
    {
      "id": "fi02",
      "claim": "clip_only",
      "narration": "顺序是选题、分镜、短镜头渲染，最后统一交给 Easel 合成整片。",
      "caption": "分镜 → 镜头 → Easel",
      "asset_id": "fi-arch-02"
    },
    {
      "id": "fi03",
      "claim": "easel_frozen",
      "narration": "Easel 的版本和提交写在 pin 文件里，并且明确标记为冻结。",
      "caption": "版本写在 pin 文件里",
      "asset_id": "fi-pin"
    },
    {
      "id": "fi04",
      "claim": "easel_frozen",
      "narration": "所以升级不是改一行配置，而是一次需要创始人批准的动作。",
      "caption": "升级要批准，不是配置",
      "asset_id": "fi-freeze"
    },
    {
      "id": "fi05",
      "claim": "short_contract",
      "narration": "短镜头的合同是：两到八秒、静音、竖屏、三十帧。",
      "caption": "2–8 秒 · 静音 · 1080×1920",
      "asset_id": "fi-contract"
    },
    {
      "id": "fi06",
      "claim": "evidence_led_blocks",
      "narration": "证据型账号要正式生产，没有裁切后的真实录屏就直接阻断。",
      "caption": "没有录屏就阻断",
      "asset_id": "fi-1024"
    },
    {
      "id": "fi07",
      "claim": "explainer_forbids_recording",
      "narration": "解释型账号反过来，拒绝任何桌面录屏和手动操作画面。",
      "caption": "解释账号拒绝录屏",
      "asset_id": "fi-explain"
    },
    {
      "id": "fi08",
      "claim": "six_templates",
      "narration": "六种镜头模板，各自编译到一个已经验证过的 Huashu 语法。",
      "caption": "六个模板，三个语法",
      "asset_id": "fi-templates"
    },
    {
      "id": "fi09",
      "claim": "generated_not_evidence",
      "narration": "生成的动画一律标成非证据，它只负责解释机制，不负责证明。",
      "caption": "生成动画不是证据",
      "asset_id": "fi-evidence"
    },
    {
      "id": "fi10",
      "claim": "cache_needs_identity",
      "narration": "缓存能不能复用，看的是渲染任务身份是否完全一致。",
      "caption": "缓存看身份，不看文件名",
      "asset_id": "fi-cache"
    },
    {
      "id": "fi11",
      "claim": "cache_needs_identity",
      "narration": "模板、参数、来源、品牌色、版本，任意一项变化就重渲。",
      "caption": "任一变就重渲",
      "asset_id": "fi-fingerprint"
    },
    {
      "id": "fi12",
      "claim": "sample_qc_pass",
      "narration": "现有四十五秒样片的技术质检结论是 PASS，但它仍然等着人工审片。",
      "caption": "PASS 之后还要人审",
      "asset_id": "fi-qc"
    },
    {
      "id": "fi13",
      "claim": null,
      "narration": "复现这条链只要三步：写分镜，跑 M5，交给 Easel 出片。",
      "caption": "三步复现",
      "asset_id": "fi-repro"
    },
    {
      "id": "fi14",
      "claim": "sample_qc_pass",
      "narration": "所以能跑通不等于能发布，发布许可始终留在人手里。",
      "caption": "能跑通 ≠ 能发布",
      "asset_id": "fi-limit"
    }
  ],
