  "claims": [
    {
      "id": "claim-mcp-stateless-boundary",
      "statement": "MCP 2026-07-28 removes protocol-level sessions and the initialize handshake, and makes each request carry protocol and routing metadata suitable for stateless deployment and gateway controls.",
      "claim_type": "mechanism",
      "source_ids": [
        "mcp-spec-20260728"
      ],
      "as_of": "2026-08-25T02:40:00+08:00",
      "evidence_locator": {
        "source_id": "mcp-spec-20260728",
        "kind": "repository-file",
        "ref": "docs/specification/2026-07-28/changelog.mdx#major-changes"
      }
    },
    {
      "id": "claim-dogwood-temporal-authorization",
      "statement": "Dogwood extends authorization decisions with accumulated event history and temporal conditions, while keeping default-deny permit/forbid policy semantics for agent actions.",
      "claim_type": "mechanism",
      "source_ids": [
        "dogwood-guide"
      ],
      "as_of": "2026-08-25T02:40:00+08:00",
      "evidence_locator": {
        "source_id": "dogwood-guide",
        "kind": "repository-file",
        "ref": "dogwood-docs/guide/00-introduction.md#what-dogwood-is"
      }
    },
    {
      "id": "claim-anthropic-explicit-permissions",
      "statement": "Claude Code documents --allowedTools as a no-prompt approval rule, --disallowedTools as deny rules, and --tools as the tool-availability control; --permission-prompt-tool can handle permission requests.",
      "claim_type": "mechanism",
      "source_ids": [
        "anthropic-claude-code-mcp-permissions"
      ],
      "as_of": "2026-08-25T02:40:00+08:00",
      "evidence_locator": {
        "source_id": "anthropic-claude-code-mcp-permissions",
        "kind": "official-documentation",
        "ref": "https://code.claude.com/docs/en/cli-usage"
      }
    },
    {
      "id": "claim-mcp-clientinfo-security-boundary",
      "statement": "MCP clientInfo is self-reported and unverified; it is intended for display, logging, and debugging and should not be relied on for security decisions.",
      "claim_type": "boundary",
      "source_ids": ["mcp-schema-clientinfo-20260728"],
      "as_of": "2026-08-25T06:35:00+08:00",
      "evidence_locator": {
