        "kind": "repository-file",
        "ref": "schema/2026-07-28/schema.ts#RequestMetaObject"
      }
    },
    {
      "id": "claim-mcp-streamable-header-scope",
      "statement": "For MCP 2026-07-28 Streamable HTTP, Mcp-Method is required for all requests while Mcp-Name is required for tools/call, resources/read, and prompts/get requests.",
      "claim_type": "mechanism",
      "source_ids": ["mcp-streamable-http-headers-20260728"],
      "as_of": "2026-08-25T06:35:00+08:00",
      "evidence_locator": {
        "source_id": "mcp-streamable-http-headers-20260728",
        "kind": "repository-file",
        "ref": "docs/specification/2026-07-28/basic/transports/streamable-http.mdx#standard-request-headers"
      }
    },
    {
      "id": "claim-mcp-transport-authorization",
      "statement": "MCP 2026-07-28 defines optional HTTP transport authorization capabilities, including OAuth resource-server behavior and access-token based requests.",
      "claim_type": "mechanism",
      "source_ids": [
        "mcp-authorization-20260728"
      ],
      "as_of": "2026-08-25T05:00:00+08:00",
