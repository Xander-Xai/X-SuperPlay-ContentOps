# EditorConfig for X-SuperPlay-ContentOps
# https://editorconfig.org

root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf

[*.{py,sh,yaml,yml,json,md,txt}]
indent_style = space
indent_size = 4

[*.ps1]
indent_style = space
indent_size = 4
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[*.yml]
indent_size = 2

[*.yaml]
indent_size = 2
