{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creator-matrix.local/schemas/human-operation-forecast.schema.json",
  "title": "Human Operation Feasibility Forecast",
  "type": "object",
  "required": ["schema_version", "content_id", "account", "topic", "route_id", "topic_mode", "status", "risk_summary", "topic_specific_assessment", "operations", "human_acceptance"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "content_id": {"type": "string", "minLength": 1},
    "account": {"const": "X•超玩1024"},
    "topic": {"type": "string", "minLength": 1},
    "route_id": {"type": "string", "minLength": 1},
    "topic_mode": {"enum": ["hotspot", "user-topic", "user-document"]},
    "status": {"enum": ["draft", "ready", "accepted", "rejected", "blocked"]},
    "generated_at": {"type": "string", "minLength": 1},
    "risk_summary": {
      "type": "object",
      "required": ["level", "blocking_reasons", "warnings"],
      "properties": {
        "level": {"enum": ["pass", "warn", "block"]},
        "blocking_reasons": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "topic_specific_assessment": {
      "type": "object",
      "required": ["status", "basis"],
      "properties": {
        "status": {"enum": ["complete", "missing"]},
        "basis": {"type": "string"}
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["operation_id", "phase", "title", "human_required", "surface", "preconditions", "screen_recording", "acceptance_criteria", "failure_modes"],
        "properties": {
          "operation_id": {"type": "string", "minLength": 1},
          "phase": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "human_required": {"type": "boolean"},
          "surface": {"type": "array", "items": {"type": "string"}},
          "preconditions": {"type": "array", "items": {"type": "string"}},
          "actions": {"type": "array", "items": {"type": "string"}},
          "screen_recording": {
            "type": "object",
            "required": ["required", "must_show", "must_hide", "minimum_seconds"],
            "properties": {
              "required": {"type": "boolean"},
              "must_show": {"type": "array", "items": {"type": "string"}},
              "must_hide": {"type": "array", "items": {"type": "string"}},
              "minimum_seconds": {"type": "number", "minimum": 0}
            }
          },
          "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
          "failure_modes": {"type": "array", "items": {"type": "object"}}
          ,"resource_requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "minimum"],
              "properties": {
                "kind": {"type": "string", "minLength": 1},
                "minimum": {"type": "number", "exclusiveMinimum": 0},
                "label": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "automatic_operations": {"type": "array", "items": {"type": "string"}},
    "human_acceptance": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["pending", "accepted", "rejected"]},
        "reviewer": {"type": "string"},
        "accepted_at": {"type": "string"},
        "note": {"type": "string"}
      }
    }
  },
  "additionalProperties": true
}
