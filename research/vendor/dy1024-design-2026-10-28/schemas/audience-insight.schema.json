{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "content_id",
    "account",
    "topic",
    "status",
    "fit_status",
    "candidate_segments",
    "segment_decision",
    "viewer_context",
    "progress_contract",
    "objections",
    "proof_expectations",
    "evidence",
    "language_bank",
    "value_contract",
    "emotional_arc",
    "research_confidence",
    "experiment_contract"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": 3},
    "content_id": {"type": "string", "minLength": 1},
    "account": {"const": "X•超玩1024"},
    "topic": {"type": "string", "minLength": 1},
    "status": {"enum": ["pending", "ready", "approved"]},
    "fit_status": {"enum": ["pending", "validated", "mixed", "exploratory"]},
    "candidate_segments": {"type": "array", "minItems": 1},
    "segment_decision": {
      "type": "object",
      "required": ["primary_segment_id", "secondary_segment_ids", "excluded_segment_ids", "identity_facets", "rationale"]
    },
    "viewer_context": {
      "type": "object",
      "required": ["viewing_trigger", "situation", "current_workaround", "awareness_level", "existing_belief", "stakes"]
    },
    "progress_contract": {
      "type": "object",
      "required": ["functional_job", "emotional_job", "social_job", "before_state", "desired_after_state"]
    },
    "objections": {"type": "array"},
    "proof_expectations": {"type": "array"},
    "evidence": {"type": "array"},
    "language_bank": {"type": "array"},
    "value_contract": {
      "type": "object",
      "required": [
        "primary_dimension",
        "secondary_dimensions",
        "practical",
        "epistemic",
        "emotional",
        "social_identity",
        "participation",
        "primary_promise",
        "meaning_for_viewer"
      ]
    },
    "emotional_arc": {
      "type": "object",
      "required": ["start_state", "recognition_cue", "turning_evidence", "end_state"]
    },
    "research_confidence": {
      "type": "object",
      "required": ["level", "reason"]
    },
    "experiment_contract": {
      "type": "object",
      "required": ["hypothesis", "learning_question", "success_signal", "cta_learning_prompt"]
    }
  }
}
