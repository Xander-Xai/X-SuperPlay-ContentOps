{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creator-matrix.local/schemas/teaching-contract.schema.json",
  "title": "Teaching and Evidence Contract",
  "type": "object",
  "required": ["schema_version", "contract_version", "contract_layer", "content_id", "status", "learning_objective", "audience_starting_point", "core_claims", "conclusion", "rhythm", "synthetic_trust"],
  "allOf": [
    {
      "if": { "properties": { "contract_version": { "minimum": 2 } } },
      "then": { "required": ["evidence_policy"] }
    }
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "contract_version": { "type": "integer", "minimum": 1 },
    "contract_layer": { "const": "immutable-contract" },
    "content_id": { "type": "string" },
    "status": { "enum": ["pending", "ready", "approved", "blocked"] },
    "learning_objective": { "type": "string", "minLength": 1 },
    "audience_starting_point": { "type": "string", "minLength": 1 },
    "evidence_floor": { "enum": ["official", "local_test", "user_owned", "hypothesis"] },
    "core_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "statement", "evidence_level", "viewer_job", "operation", "input_condition", "changed_variable", "checkpoint", "evidence_asset_ids", "metric", "result", "boundary", "conclusion_dependency", "status"],
        "properties": {
          "claim_id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "evidence_level": { "enum": ["official", "local_test", "user_owned", "hypothesis"] },
          "viewer_job": { "type": "string", "minLength": 1 },
          "operation": { "type": "string", "minLength": 1 },
          "input_condition": { "type": "string", "minLength": 1 },
          "changed_variable": { "type": "string", "minLength": 1 },
          "checkpoint": { "type": "string", "minLength": 1 },
          "evidence_asset_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "metric": { "type": "string", "minLength": 1 },
          "result": { "type": "string", "minLength": 1 },
          "boundary": { "type": "string", "minLength": 1 },
          "conclusion_dependency": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pending", "verified", "blocked"] }
        },
        "additionalProperties": true
      }
    },
    "conclusion": {
      "type": "object",
      "required": ["verdict", "if_then_rules", "costs", "boundaries", "next_step"],
      "properties": {
        "verdict": { "type": "string", "minLength": 1 },
        "if_then_rules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "costs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "boundaries": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "next_step": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "rhythm": {
      "type": "object",
      "required": ["mode", "theory_streak_max_seconds", "evidence_interval_seconds", "calibration"],
      "properties": {
        "mode": { "enum": ["hypothesis", "validated"] },
        "theory_streak_max_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "evidence_interval_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "calibration": { "enum": ["none", "ab-test", "comprehension-test", "ab-test+comprehension-test"] }
      },
      "additionalProperties": true
    },
    "synthetic_trust": {
      "type": "object",
      "required": ["presenter_role", "disclosure_required", "evidence_exclusion"],
      "properties": {
        "presenter_role": { "enum": ["explain_only", "explain_and_transition"] },
        "disclosure_required": { "type": "boolean" },
        "disclosure_location": { "type": "string" },
        "evidence_exclusion": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "evidence_policy": {
      "type": "object",
      "required": ["version", "status", "title_promise", "primary_claim_id", "hook_claim_id", "packaging_structure", "claim_to_scene_required"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["planned", "verified", "blocked"] },
        "title_promise": { "type": "string", "minLength": 1 },
        "primary_claim_id": { "type": "string", "minLength": 1 },
        "hook_claim_id": { "type": "string", "minLength": 1 },
        "packaging_structure": { "const": "hook-body-close" },
        "claim_to_scene_required": { "const": true },
        "transfer_limit": { "type": "string" }
      },
      "additionalProperties": true
    },
    "narrative_voice": {
      "type": "object",
      "required": ["mode", "relationship", "colloquial_budget", "max_per_scene", "max_consecutive", "allowed_moves", "forbidden_moves", "fact_lock_tokens"],
      "properties": {
        "mode": { "enum": ["neutral-technical", "controlled-colloquial", "formal"] },
        "relationship": { "enum": ["peer-to-peer", "expert-to-student", "editorial"] },
        "colloquial_budget": { "type": "integer", "minimum": 0 },
        "max_per_scene": { "type": "integer", "minimum": 0, "maximum": 2 },
        "max_consecutive": { "type": "integer", "minimum": 0, "maximum": 3 },
        "allowed_moves": { "type": "array", "items": { "type": "string" } },
        "forbidden_moves": { "type": "array", "items": { "type": "string" } },
        "fact_lock_tokens": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
