{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creator-matrix.local/schemas/topic-backlog.schema.json",
  "title": "Creator Topic Backlog",
  "type": "object",
  "required": ["schema_version", "account", "items"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "account": { "const": "X•超玩1024" },
    "status": { "enum": ["active", "paused", "archived"] },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic_id", "title", "account", "status", "priority"],
        "properties": {
          "topic_id": { "type": "string", "minLength": 1 },
          "content_id": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "account": { "const": "X•超玩1024" },
          "pillar": { "type": "string" },
          "format": { "type": "string" },
          "target_platforms": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["douyin", "xiaohongshu", "wechat_channels"] }
          },
          "audience_validation": {
            "type": "object",
            "required": ["status", "viewer_quote", "viewer_trigger", "current_workaround", "pain_or_stakes", "desired_progress", "source_refs"],
            "properties": {
              "status": { "enum": ["pending", "approved", "blocked"] },
              "viewer_quote": { "type": "string" },
              "viewer_trigger": { "type": "string" },
              "current_workaround": { "type": "string" },
              "pain_or_stakes": { "type": "string" },
              "desired_progress": { "type": "string" },
              "source_refs": { "type": "array", "items": { "type": "string" } }
            }
          },
          "platform_policy_ref": { "type": "string" },
          "platform_risk_class": { "enum": ["low", "medium", "high", "blocked"] },
          "safe_title_by_platform": { "type": "object" },
          "cta_mode_by_platform": { "type": "object" },
          "permission_status": { "enum": ["unknown", "pending_review", "approved", "private_do_not_publish"] },
          "commercial_disclosure": { "type": "object" },
          "ai_disclosure": { "type": "object" },
          "human_review_status": { "enum": ["not_started", "pending", "approved", "blocked"] },
          "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
          "status": { "enum": ["idea", "queued", "in-progress", "published", "paused"] },
          "evidence_floor": { "type": "integer", "minimum": 1 },
          "scheduled_for": { "type": "string" },
          "experiment": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
