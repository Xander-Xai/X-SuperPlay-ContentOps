{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creator-matrix.local/schemas/plugin-native-scene-brief.schema.json",
  "title": "Plugin-native scene brief",
  "type": "object",
  "required": ["schema_version", "content_id", "account", "status", "scenes"],
  "properties": {
    "schema_version": {"const": 1},
    "content_id": {"type": "string", "minLength": 1},
    "account": {"type": "string", "minLength": 1},
    "status": {"enum": ["pending", "ready", "approved", "blocked"]},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scene_id", "start", "duration", "headline", "subtitle", "safe_area", "mode", "plugin_source_ownership"],
        "properties": {
          "scene_id": {"type": "string", "minLength": 1},
          "start": {"type": "number", "minimum": 0},
          "duration": {"type": "number", "exclusiveMinimum": 0},
          "headline": {"type": "string", "minLength": 1},
          "subtitle": {"type": "string"},
          "safe_area": {"type": "string", "minLength": 1},
          "mode": {"enum": ["hyperframes-full-frame", "remotion-full-frame", "interop-overlay"]},
          "plugin_source_ownership": {"type": "object"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
