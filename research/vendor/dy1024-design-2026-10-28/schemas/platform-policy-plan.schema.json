{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creator-matrix.local/schemas/platform-policy-plan.schema.json",
  "title": "Multi-platform Topic Plan",
  "type": "object",
  "required": ["schema_version", "project_id", "policy_id", "platforms", "topics"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "policy_id": { "type": "string", "minLength": 1 },
    "policy_verified_at": { "type": "string", "minLength": 1 },
    "platforms": { "type": "array", "minItems": 3, "items": { "type": "string" } },
    "topics": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["topic_id", "scheduled_for", "canonical_topic", "signal_status", "audience_validation", "target_platforms", "platform_variants"],
        "properties": {
          "topic_id": { "type": "string", "minLength": 1 },
          "scheduled_for": { "type": "string", "format": "date" },
          "canonical_topic": { "type": "string", "minLength": 1 },
          "signal_status": { "const": "validated" },
          "audience_validation": {
            "type": "object",
            "required": ["status", "viewer_quote", "viewer_trigger", "current_workaround", "pain_or_stakes", "desired_progress", "source_refs"],
            "properties": {
              "status": { "const": "approved" },
              "viewer_quote": { "type": "string", "minLength": 1 },
              "viewer_trigger": { "type": "string", "minLength": 1 },
              "current_workaround": { "type": "string", "minLength": 1 },
              "pain_or_stakes": { "type": "string", "minLength": 1 },
              "desired_progress": { "type": "string", "minLength": 1 },
              "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          },
          "target_platforms": { "type": "array", "minItems": 3, "items": { "type": "string" } },
          "platform_variants": { "type": "object", "minProperties": 3 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
