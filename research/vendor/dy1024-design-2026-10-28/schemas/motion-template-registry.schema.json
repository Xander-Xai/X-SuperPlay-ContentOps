{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creator-matrix.local/schemas/motion-template-registry.schema.json",
  "title": "AI Sentinel Motion Template Registry",
  "type": "object",
  "required": ["schema_version", "account", "platform", "entries"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "account": { "const": "X•超玩1024" },
    "platform": { "const": "douyin" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["template_id", "renderer", "source_repo", "license", "status", "supported_ratios", "fps"],
        "properties": {
          "template_id": { "type": "string", "minLength": 1 },
          "renderer": { "enum": ["remotion", "hyperframes", "pipeline"] },
          "source_repo": { "type": "string", "format": "uri" },
          "source_commit": { "type": "string" },
          "local_path": { "type": "string" },
          "license": { "type": "string", "minLength": 1 },
          "attribution": { "type": "string" },
          "status": { "enum": ["adapter-ready", "cloned", "clone-pending", "research-only", "blocked"] },
          "supported_ratios": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "fps": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1 },
          "safe_area": { "type": "string" },
          "deterministic": { "type": "boolean" },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
