{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creator-matrix.local/schemas/screen-recording-recommendation.schema.json",
  "title": "Screen Recording Recommendation",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "pillar",
    "content_type",
    "primary_mode",
    "surface",
    "capture_method",
    "layout",
    "evidence_level",
    "source_ratio",
    "delivery_ratio",
    "audio_binding",
    "screenshot_binding",
    "must_show",
    "must_hide"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "status": {"enum": ["ready", "pending-audio-handoff"]},
    "pillar": {"enum": ["AI 新能力实测", "AI × 现实任务实验", "AI 生意实验室"]},
    "content_type": {"type": "string"},
    "primary_mode": {"enum": ["browser_evidence", "terminal_evidence", "whiteboard_excalidraw", "html_demo", "task_screen", "browser_behavior"]},
    "surface": {"type": "string", "minLength": 1},
    "capture_method": {"type": "string", "minLength": 1},
    "layout": {"type": "string", "minLength": 1},
    "evidence_level": {"enum": ["direct_observation", "task_observation", "explanation", "demonstration", "business_behavior"]},
    "source_ratio": {"type": "string", "minLength": 1},
    "delivery_ratio": {"type": "string", "minLength": 1},
    "audio_binding": {"type": "object", "required": ["audio_handoff", "cue_ids", "cue_count"]},
    "screenshot_binding": {"type": "object", "required": ["required", "status", "source_ids", "target_ids"]},
    "must_show": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "must_hide": {"type": "array", "items": {"type": "string"}},
    "human_required": {"type": "boolean"},
    "minimum_seconds": {"type": "number", "minimum": 0}
  },
  "additionalProperties": true
}
