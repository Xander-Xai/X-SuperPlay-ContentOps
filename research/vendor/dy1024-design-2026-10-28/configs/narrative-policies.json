{
  "schema_version": 1,
  "hook": {
    "max_seconds": 5,
    "must_be_specific": true,
    "must_resolve_by_seconds": 12,
    "allowed_methods": ["cognitive_dissonance", "behavior_identity", "result_first"],
    "forbidden": ["false_fear", "unsupported_absolute_claim", "fake_scarcity"]
  },
  "evidence": {
    "required_for_core_claims": true,
    "levels": ["official", "local_test", "user_owned", "hypothesis"],
    "language_by_level": {
      "official": "官方资料显示",
      "local_test": "我在这台机器上测到",
      "user_owned": "素材记录里能看到",
      "hypothesis": "目前只能推测"
    }
  },
  "open_loop": {
    "core_answer_must_be_delivered": true,
    "only_next_step_may_remain": true
  },
  "cta": {
    "max_count": 1,
    "must_match_content": true
  },
  "safety": {
    "replace_white_hat_hacker_language_with": ["授权内优化", "合规捷径", "边界测试", "流程自动化"],
    "block_if_unresolved": true
  }
}
